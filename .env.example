# BitonX environment template

BITONX_ENV=development
BITONX_LOG_LEVEL=INFO
BITONX_API_HOST=0.0.0.0
BITONX_API_PORT=8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bitonx
POSTGRES_USER=bitonx
POSTGRES_PASSWORD=bitonx_dev_password
DATABASE_URL=postgresql+psycopg://bitonx:bitonx_dev_password@postgres:5432/bitonx

NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bitonx_dev_password
NEO4J_URI=bolt://neo4j:7687

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=bitonx
RABBITMQ_DEFAULT_PASS=bitonx_dev_password
RABBITMQ_URL=amqp://bitonx:bitonx_dev_password@rabbitmq:5672//

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=bitonx
MINIO_ROOT_PASSWORD=bitonx_dev_password
MINIO_BUCKET_UPLOADS=bitonx-uploads
MINIO_BUCKET_ARTIFACTS=bitonx-artifacts
MINIO_BUCKET_REPORTS=bitonx-reports

JWT_SECRET_KEY=change-me-in-real-environments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=BitonX Quant

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
