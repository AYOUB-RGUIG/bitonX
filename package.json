{
  "name": "bitonx",
  "private": true,
  "version": "0.2.0",
  "description": "BitonX Quant production foundation workspace",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bitonx/frontend dev",
